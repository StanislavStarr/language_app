{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make up)",
      "Bash(make down)",
      "Bash(make migrate)",
      "Bash(make migration:*)",
      "Bash(make backend-check)",
      "Bash(make backend-fix)",
      "Bash(make mobile-check)",
      "Bash(make api-types)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run mypy:*)",
      "Bash(uv run alembic:*)",
      "Bash(uv sync:*)",
      "Bash(npm run:*)",
      "Bash(npx jest:*)",
      "Bash(npx tsc:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)"
    ],
    "ask": [
      "Bash(uv add:*)",
      "Bash(npm install:*)",
      "Bash(npx expo install:*)",
      "Bash(uv run python -m evals:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(make db-reset)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-changed-file.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
